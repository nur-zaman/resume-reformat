# Supabase - copy to .env.local and fill in from the project's Connect dialog.

# Public and safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server-only. NEVER prefix with NEXT_PUBLIC_. This bypasses RLS and is used only
# for the pre-auth allowlist check.
SUPABASE_SECRET_KEY=sb_secret_your-key

# Canonical app origin used to build outbound magic-link redirects.
# Local dev: http://localhost:3000 | Production: https://your-domain
SITE_URL=http://localhost:3000

# AI (resume parsing/tailoring). The exact model id is deployment configuration.
# Parsing accepts pasted text or a PDF upload (sent to Gemini as a file part).
AI_MODEL_ID=gemini-3.1-flash-lite
# Server-only AI credential. NEVER prefix with NEXT_PUBLIC_.
GOOGLE_GENERATIVE_AI_API_KEY=your-google-generative-ai-key
