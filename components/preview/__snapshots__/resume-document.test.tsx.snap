exports[`ResumeDocument (HTML) > renders an empty resume (header only) 1`] = `"<div class="resume-paper" style="box-sizing:border-box;width:612pt;min-height:792pt;padding:46pt 52pt;background:#ffffff;color:#1a1a1a;font-family:var(--font-serif), Georgia, &#x27;Times New Roman&#x27;, serif;font-size:10pt;line-height:1.34"><header style="margin-bottom:14pt"></header></div>"`;

exports[`ResumeDocument (HTML) > renders the long multi-page resume 1`] = `"<div class="resume-paper" style="box-sizing:border-box;width:612pt;min-height:792pt;padding:46pt 52pt;background:#ffffff;color:#1a1a1a;font-family:var(--font-serif), Georgia, &#x27;Times New Roman&#x27;, serif;font-size:10pt;line-height:1.34"><header style="margin-bottom:14pt"><div style="font-size:21pt;font-weight:700;line-height:1.2">Jordan Rivera</div><div style="font-size:11pt;margin-top:3pt;line-height:1.2">Staff Software Engineer · Platform &amp; Infrastructure</div><div style="font-size:9pt;color:#555555;margin-top:3pt">jordan.rivera@example.com  ·  +1 206 555 0147  ·  Seattle, WA  ·  <a href="https://github.com/jordanrivera" style="color:#1a1a1a">GitHub</a>  ·  <a href="https://jordanrivera.dev" style="color:#1a1a1a">Website</a></div></header><section style="margin-top:13pt"><h2 style="font-size:10pt;font-weight:700;text-transform:uppercase;letter-spacing:0.6pt;border-bottom:0.75pt solid #222222;padding-bottom:2pt;margin:0">Summary</h2><div style="margin-top:6pt"><p style="margin:0;margin-bottom:4pt"><span>Staff engineer with twelve years building and operating large-scale distributed systems, developer platforms, and the teams that own them. Equally comfortable in incident response and long-horizon architecture.</span></p></div></section><section style="margin-top:13pt"><h2 style="font-size:10pt;font-weight:700;text-transform:uppercase;letter-spacing:0.6pt;border-bottom:0.75pt solid #222222;padding-bottom:2pt;margin:0">Skills</h2><div style="margin-top:6pt"><div style="margin-bottom:2.5pt"><span style="font-weight:700">Languages: </span>Go, Rust, TypeScript, Python, SQL</div><div style="margin-bottom:2.5pt"><span style="font-weight:700">Infrastructure: </span>Kubernetes, Terraform, AWS, GCP</div><div style="margin-bottom:2.5pt"><span style="font-weight:700">Data: </span>PostgreSQL, Kafka, ClickHouse, Redis</div><div style="margin-bottom:2.5pt"><span style="font-weight:700">Observability: </span>Prometheus, Grafana, OpenTelemetry</div></div></section><section style="margin-top:13pt"><h2 style="font-size:10pt;font-weight:700;text-transform:uppercase;letter-spacing:0.6pt;border-bottom:0.75pt solid #222222;padding-bottom:2pt;margin:0">Experience</h2><div style="margin-top:6pt"><div style="margin-bottom:9pt"><div style="display:flex;justify-content:space-between;gap:12pt"><span><span style="font-weight:700">Helios Cloud</span></span><span style="color:#555555;font-size:9.5pt;white-space:nowrap">2022 – Present</span></div><div style="display:flex;justify-content:space-between;gap:12pt"><span><span style="font-style:italic">Staff Software Engineer</span></span><span style="color:#555555;font-size:9.5pt;white-space:nowrap">Seattle, WA</span></div><div style="margin-top:3pt"><ul style="margin:0;padding-left:12pt;list-style-type:disc;list-style-position:outside"><li style="margin-bottom:2.5pt"><span>Architected a multi-region control plane serving 40k internal deployments per day with a 99.99% success SLO.</span></li><li style="margin-bottom:2.5pt"><span>Led a five-engineer team migrating the orchestration layer from a monolith to event-driven services.</span></li><li style="margin-bottom:2.5pt"><span>Cut median deploy time from 14 minutes to under 3 by redesigning the build and artifact pipeline.</span></li><li style="margin-bottom:2.5pt"><span>Authored the platform&#x27;s capacity-planning model, avoiding an estimated $2.1M in over-provisioning.</span></li></ul></div></div><div style="margin-bottom:9pt"><div style="display:flex;justify-content:space-between;gap:12pt"><span><span style="font-weight:700">Northwind Labs</span></span><span style="color:#555555;font-size:9.5pt;white-space:nowrap">2019 – 2022</span></div><div style="display:flex;justify-content:space-between;gap:12pt"><span><span style="font-style:italic">Senior Software Engineer</span></span><span style="color:#555555;font-size:9.5pt;white-space:nowrap">San Francisco, CA</span></div><div style="margin-top:3pt"><ul style="margin:0;padding-left:12pt;list-style-type:disc;list-style-position:outside"><li style="margin-bottom:2.5pt"><span>Owned the checkout reliability program, reducing p99 latency by 38% across the core flow.</span></li><li style="margin-bottom:2.5pt"><span>Built a self-serve feature-flag service adopted by 30+ teams within two quarters.</span></li><li style="margin-bottom:2.5pt"><span>Introduced a lightweight design-review process now standard across engineering.</span></li><li style="margin-bottom:2.5pt"><span>Mentored four engineers, two of whom were promoted to senior during the period.</span></li></ul></div></div><div style="margin-bottom:9pt"><div style="display:flex;justify-content:space-between;gap:12pt"><span><span style="font-weight:700">Cobalt Systems</span></span><span style="color:#555555;font-size:9.5pt;white-space:nowrap">2016 – 2019</span></div><div style="display:flex;justify-content:space-between;gap:12pt"><span><span style="font-style:italic">Software Engineer</span></span><span style="color:#555555;font-size:9.5pt;white-space:nowrap">Remote</span></div><div style="margin-top:3pt"><ul style="margin:0;padding-left:12pt;list-style-type:disc;list-style-position:outside"><li style="margin-bottom:2.5pt"><span>Built the billing reconciliation pipeline processing 2M events per day with exactly-once semantics.</span></li><li style="margin-bottom:2.5pt"><span>Cut nightly batch runtime from 6 hours to 45 minutes via incremental processing.</span></li><li style="margin-bottom:2.5pt"><span>Implemented the first end-to-end tracing across the payments stack.</span></li></ul></div></div><div style="margin-bottom:9pt"><div style="display:flex;justify-content:space-between;gap:12pt"><span><span style="font-weight:700">Beacon Analytics</span></span><span style="color:#555555;font-size:9.5pt;white-space:nowrap">2014 – 2016</span></div><div style="display:flex;justify-content:space-between;gap:12pt"><span><span style="font-style:italic">Software Engineer</span></span><span style="color:#555555;font-size:9.5pt;white-space:nowrap">Austin, TX</span></div><div style="margin-top:3pt"><ul style="margin:0;padding-left:12pt;list-style-type:disc;list-style-position:outside"><li style="margin-bottom:2.5pt"><span>Developed the ingestion service handling 500GB of event data daily.</span></li><li style="margin-bottom:2.5pt"><span>Reduced query costs 45% by introducing columnar storage and partition pruning.</span></li><li style="margin-bottom:2.5pt"><span>Shipped the customer-facing dashboards used by the company&#x27;s 200 largest accounts.</span></li></ul></div></div><div style="margin-bottom:9pt"><div style="display:flex;justify-content:space-between;gap:12pt"><span><span style="font-weight:700">Quill Software</span></span><span style="color:#555555;font-size:9.5pt;white-space:nowrap">2012 – 2014</span></div><div style="display:flex;justify-content:space-between;gap:12pt"><span><span style="font-style:italic">Junior Software Engineer</span></span><span style="color:#555555;font-size:9.5pt;white-space:nowrap">Portland, OR</span></div><div style="margin-top:3pt"><ul style="margin:0;padding-left:12pt;list-style-type:disc;list-style-position:outside"><li style="margin-bottom:2.5pt"><span>Built REST APIs and background workers for a document-collaboration product.</span></li><li style="margin-bottom:2.5pt"><span>Added automated test coverage that caught a class of recurring data-loss bugs.</span></li><li style="margin-bottom:2.5pt"><span>Contributed the initial CI configuration adopted across the engineering org.</span></li></ul></div></div></div></section><section style="margin-top:13pt"><h2 style="font-size:10pt;font-weight:700;text-transform:uppercase;letter-spacing:0.6pt;border-bottom:0.75pt solid #222222;padding-bottom:2pt;margin:0">Education</h2><div style="margin-top:6pt"><div style="margin-bottom:9pt"><div style="display:flex;justify-content:space-between;gap:12pt"><span><span style="font-weight:700">University of Washington</span></span><span style="color:#555555;font-size:9.5pt;white-space:nowrap">2010 – 2012</span></div><div style="display:flex;justify-content:space-between;gap:12pt"><span><span style="font-style:italic">M.S. in Computer Science</span></span><span style="color:#555555;font-size:9.5pt;white-space:nowrap">Seattle, WA</span></div><div style="margin-top:3pt"></div></div><div style="margin-bottom:9pt"><div style="display:flex;justify-content:space-between;gap:12pt"><span><span style="font-weight:700">Oregon State University</span></span><span style="color:#555555;font-size:9.5pt;white-space:nowrap">2006 – 2010</span></div><div style="display:flex;justify-content:space-between;gap:12pt"><span><span style="font-style:italic">B.S. in Computer Science</span></span><span style="color:#555555;font-size:9.5pt;white-space:nowrap">Corvallis, OR</span></div><div style="margin-top:3pt"></div></div></div></section><section style="margin-top:13pt"><h2 style="font-size:10pt;font-weight:700;text-transform:uppercase;letter-spacing:0.6pt;border-bottom:0.75pt solid #222222;padding-bottom:2pt;margin:0">Open Source</h2><div style="margin-top:6pt"><p style="margin:0;margin-bottom:4pt"><span>Maintainer of a widely-used Go rate-limiting library (4k+ stars).</span></p><p style="margin:0;margin-bottom:4pt"><span>Regular contributor to the OpenTelemetry Collector.</span></p></div></section></div>"`;

exports[`ResumeDocument (HTML) > renders the realistic single-page resume 1`] = `"<div class="resume-paper" style="box-sizing:border-box;width:612pt;min-height:792pt;padding:46pt 52pt;background:#ffffff;color:#1a1a1a;font-family:var(--font-serif), Georgia, &#x27;Times New Roman&#x27;, serif;font-size:10pt;line-height:1.34"><header style="margin-bottom:14pt"><div style="font-size:21pt;font-weight:700;line-height:1.2">Avery Nguyen</div><div style="font-size:11pt;margin-top:3pt;line-height:1.2">Senior Software Engineer</div><div style="font-size:9pt;color:#555555;margin-top:3pt">avery.nguyen@example.com  ·  +1 415 555 0199  ·  San Francisco, CA  ·  <a href="https://github.com/averynguyen" style="color:#1a1a1a">GitHub</a>  ·  <a href="https://linkedin.com/in/averynguyen" style="color:#1a1a1a">LinkedIn</a></div></header><section style="margin-top:13pt"><h2 style="font-size:10pt;font-weight:700;text-transform:uppercase;letter-spacing:0.6pt;border-bottom:0.75pt solid #222222;padding-bottom:2pt;margin:0">Summary</h2><div style="margin-top:6pt"><p style="margin:0;margin-bottom:4pt"><span>Backend-leaning full-stack engineer with eight years building reliable, high-traffic web services.</span></p><p style="margin:0;margin-bottom:4pt"><span>Drove a 40% reduction in p99 API latency across the core checkout platform.</span></p></div></section><section style="margin-top:13pt"><h2 style="font-size:10pt;font-weight:700;text-transform:uppercase;letter-spacing:0.6pt;border-bottom:0.75pt solid #222222;padding-bottom:2pt;margin:0">Skills</h2><div style="margin-top:6pt"><div style="margin-bottom:2.5pt"><span style="font-weight:700">Languages: </span>TypeScript, Go, Python, SQL</div><div style="margin-bottom:2.5pt"><span style="font-weight:700">Platforms: </span>AWS, PostgreSQL, Kubernetes, Redis</div></div></section><section style="margin-top:13pt"><h2 style="font-size:10pt;font-weight:700;text-transform:uppercase;letter-spacing:0.6pt;border-bottom:0.75pt solid #222222;padding-bottom:2pt;margin:0">Experience</h2><div style="margin-top:6pt"><div style="margin-bottom:9pt"><div style="display:flex;justify-content:space-between;gap:12pt"><span><span style="font-weight:700">Northwind Labs</span></span><span style="color:#555555;font-size:9.5pt;white-space:nowrap">2021 – Present</span></div><div style="display:flex;justify-content:space-between;gap:12pt"><span><span style="font-style:italic">Senior Software Engineer</span></span><span style="color:#555555;font-size:9.5pt;white-space:nowrap">San Francisco, CA</span></div><div style="margin-top:3pt"><ul style="margin:0;padding-left:12pt;list-style-type:disc;list-style-position:outside"><li style="margin-bottom:2.5pt"><span>Led the migration of the monolith checkout service to a set of Go microservices.</span></li><li style="margin-bottom:2.5pt"><span>Mentored four engineers and introduced a lightweight design-review process.</span></li></ul></div></div><div style="margin-bottom:9pt"><div style="display:flex;justify-content:space-between;gap:12pt"><span><span style="font-weight:700">Cobalt Systems</span></span><span style="color:#555555;font-size:9.5pt;white-space:nowrap">2017 – 2021</span></div><div style="display:flex;justify-content:space-between;gap:12pt"><span><span style="font-style:italic">Software Engineer</span></span><span style="color:#555555;font-size:9.5pt;white-space:nowrap">Remote</span></div><div style="margin-top:3pt"><ul style="margin:0;padding-left:12pt;list-style-type:disc;list-style-position:outside"><li style="margin-bottom:2.5pt"><span>Built the billing reconciliation pipeline processing 2M events per day.</span></li><li style="margin-bottom:2.5pt"><span>Cut nightly batch runtime from 6 hours to 45 minutes.</span></li></ul></div></div></div></section><section style="margin-top:13pt"><h2 style="font-size:10pt;font-weight:700;text-transform:uppercase;letter-spacing:0.6pt;border-bottom:0.75pt solid #222222;padding-bottom:2pt;margin:0">Education</h2><div style="margin-top:6pt"><div style="margin-bottom:9pt"><div style="display:flex;justify-content:space-between;gap:12pt"><span><span style="font-weight:700">University of Waterloo</span></span><span style="color:#555555;font-size:9.5pt;white-space:nowrap">2013 – 2017</span></div><div style="display:flex;justify-content:space-between;gap:12pt"><span><span style="font-style:italic">B.A.Sc. in Computer Engineering</span></span><span style="color:#555555;font-size:9.5pt;white-space:nowrap">Waterloo, ON</span></div><div style="margin-top:3pt"></div></div></div></section><section style="margin-top:13pt"><h2 style="font-size:10pt;font-weight:700;text-transform:uppercase;letter-spacing:0.6pt;border-bottom:0.75pt solid #222222;padding-bottom:2pt;margin:0">Open Source</h2><div style="margin-top:6pt"><p style="margin:0;margin-bottom:4pt"><span>Maintainer of a popular open-source rate-limiting library (3k+ stars).</span></p></div></section></div>"`;
